page { background: #f8fafc; color: #0f172a; font-family: Arial, sans-serif; }
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 12rpx 40rpx rgba(15,23,42,0.08); margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.subtitle { font-size: 28rpx; color: #475569; margin-bottom: 12rpx; }
.primary-btn { background: #0f766e; color: #fff; border-radius: 999rpx; margin-top: 12rpx; }
.secondary-btn { background: #e2e8f0; color: #0f172a; border-radius: 999rpx; margin-top: 12rpx; }
.tag { display: inline-block; padding: 6rpx 16rpx; border-radius: 999rpx; background: #ccfbf1; color: #115e59; font-size: 24rpx; margin-right: 12rpx; margin-bottom: 12rpx; }
.muted { color: #64748b; font-size: 26rpx; }
