<view class="container"><view class="card"><view class="title">历史记录</view><view class="muted" wx:if="{{loading}}">加载中...</view><view class="muted" wx:elif="{{!jobs.length}}">暂无记录，请先登录并上传视频。</view><view wx:for="{{jobs}}" wx:key="id" class="card" data-job-id="{{item.id}}" bindtap="openJob"><view class="subtitle">任务 #{{item.id}} - {{item.video_name}}</view><view class="tag">{{item.status}}</view><view class="muted">{{item.created_at}}</view></view></view></view>
