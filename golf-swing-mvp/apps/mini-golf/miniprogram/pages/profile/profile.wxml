<view class="container"><view class="card"><view class="title">我的</view><view wx:if="{{user}}"><view class="subtitle">用户 ID：{{user.id}}</view><view class="muted">昵称：{{user.nickname}}</view></view><view wx:else class="muted">当前未登录，请先完成 mock 登录。</view><button class="primary-btn" bindtap="login">Mock 登录</button></view><view class="card"><view class="title">会员状态</view><view wx:if="{{subscription && subscription.status === 'active'}}" class="muted">已开通 {{subscription.plan_type}}，有效期至 {{subscription.expire_at}}</view><view wx:else class="muted">当前未开通会员。</view><button class="secondary-btn" bindtap="buyMembership">开通月卡会员（69.9）</button></view></view>
